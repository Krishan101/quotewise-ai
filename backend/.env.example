# NicrronNinoo LLM gap-filler (OpenAI-compatible). Without it, rules-only extraction runs.
NICRRON_API_KEY=
NICRRON_BASE_URL=https://api.nicrron.ai/v1
NICRRON_MODEL=nicrron/auto

# Optional: screenshot / image RFQ parsing (Claude Vision in parser.py)
ANTHROPIC_API_KEY=

# PRISM by Block Convey (prismtrace-sdk). Settings -> API Keys, "custom" purpose so the key
# can both send traces and read them back. Leave blank to run without PRISM.
PRISMTRACE_API_KEY=
PRISMTRACE_PROJECT_ID=
PRISMTRACE_HOST=https://api.prism.blockconvey.com
PRISM_AGENT_NAME=quotewise-rfq-agent
PRISM_AGENT_ID=quotewise-rfq-agent

# Comma-separated frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
